# Credenciais do PostgreSQL local. Copie para .env (ignorado pelo git) e defina a senha.
# DB_PASSWORD é obrigatório e fica vazio de propósito: sem ele o docker compose não sobe.
DB_NAME=locadora
DB_USER=locadora
DB_PASSWORD=

# URL JDBC que o Spring Boot vai ler na Fase 2 (application.yml: ${DB_URL}).
# Porta 55432 (não a padrão 5432), para o Postgres do Docker não conflitar com
# um Postgres local ou com outro projeto nesta máquina.
# escapeSyntaxCallMode=callIfNoReturn é necessário para CALL de stored procedures
# via JDBC {call ...} — ver skill roteiro-bd2, seção "pegadinhas".
DB_URL=jdbc:postgresql://localhost:55432/locadora?escapeSyntaxCallMode=callIfNoReturn

# [ROTEIRO-1c-CONEXAO] Só para "docker compose --profile app up -d --build" (sistema completo
# em Docker). O container NÃO usa o DB_URL acima: o compose monta a URL do app com o host
# "db" (rede interna, porta 5432) em vez de localhost:55432, e repassa DB_USER/DB_PASSWORD.
# Perfil Spring do container; "dev" (padrão) carrega os dados de demonstração e permite o
# login por http://localhost. Outro valor roda só as migrations e exige HTTPS (cookie Secure).
SPRING_PROFILES_ACTIVE=dev
